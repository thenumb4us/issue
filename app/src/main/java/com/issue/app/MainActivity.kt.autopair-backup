    private fun parentLogin(
        email: String,
        password: String
    ) {
        showLoading("Signing in...")

        background(
            action = {
                ApiClient.post(
                    "/api/parent/auth/login",
                    JSONObject().apply {
                        put("email", email)
                        put("password", password)
                    }
                )
            },
            success = { response ->
                if (response.statusCode in 200..299) {
                    val json = safeJson(response.body)

                    val token = findString(
                        json,
                        "token",
                        "accessToken",
                        "access_token",
                        "jwt"
                    )

                    if (token.isBlank()) {
                        toast(
                            "Login succeeded but token was missing"
                        )
                        showParentLogin()
                        return@background
                    }

                    prefs()
                        .edit()
                        .putString(
                            KEY_PARENT_TOKEN,
                            token
                        )
                        .apply()

                    loadParentDashboard()
                } else {
                    toast(
                        apiMessage(
                            response.body,
                            "Login failed"
                        )
                    )
                    showParentLogin()
                }
            },
            failure = {
                toast(
                    "Connection error: " +
                        (it.message ?: "Unknown")
                )
                showParentLogin()
            }
        )
    }

