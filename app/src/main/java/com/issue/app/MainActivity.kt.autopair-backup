        TextView(this).apply {
            text = value
            textSize = 34f
            letterSpacing = 0.18f
            setTextColor(Color.WHITE)
            gravity = Gravity.CENTER_HORIZONTAL
            setPadding(10, 18, 10, 18)
            setBackgroundColor(Color.rgb(28, 24, 42))
        }

